@echo off
chcp 65001 > nul
title Установка зависимостей Roblox RP Overlay

echo ========================================================
echo [ПРОЦЕСС] Начинается установка библиотек...
echo ========================================================

:: 1. Проверяем, существует ли файл требований
if not exist req.txt (
    if exist requirements.txt (
        rename requirements.txt req.txt
    ) else (
        echo [ОШИБКА] Файл req.txt или requirements.txt не найден!
        echo Поместите этот .bat файл в ту же папку, где находится файл с библиотеками.
        goto error
    )
)

:: 2. Обновляем сам pip перед установкой для исключения ошибок сборки
echo [1/2] Обновление пакетного менеджера pip...
python -m pip install --upgrade pip

:: 3. Запускаем установку зависимостей
echo [2/2] Установка библиотек из req.txt...
python -m pip install -r req.txt

if %errorlevel% neq 0 goto error

echo ========================================================
echo [УСПЕХ] Все библиотеки успешно установлены!
echo ========================================================
pause
exit

:error
echo ========================================================
echo [ОШИБКА] Произошел сбой при установке зависимостей.
echo Убедитесь, что Python добавлен в системные переменные PATH.
echo ========================================================
pause
